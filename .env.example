# Copy to .env to override defaults (all optional; docker-compose has sane defaults).
POSTGRES_USER=stn
POSTGRES_PASSWORD=stn
POSTGRES_DB=stn
API_PORT=8000
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=30
LOG_LEVEL=INFO

# Local (non-docker) development:
# DATABASE_URL=postgresql+psycopg2://stn:stn@localhost:5432/stn
# TEST_DATABASE_URL=postgresql+psycopg2://stn:stn@localhost:5432/stn_test
